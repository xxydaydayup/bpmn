# 浏览器请求前缀；VITE_ 变量会暴露到前端，不要填写密钥。
VITE_API_BASE_URL=/api
# 开发服务将 /api 原样代理到后端；当前联调后端示例为 9000。
API_PROXY_TARGET=http://192.168.124.202:9000
# 可选，后端业务 API 的 Basic Auth，仅由 Vite 服务端读取。
API_PROXY_AUTH=tenant-a:pass-a
# Camunda 7 原生 REST 仅用于开发联调；代理会把 /api/camunda 重写为 /engine-rest。
# 直连官方引擎时填 8085；验证后端透传时填 9000，并设置 CAMUNDA_PROXY_AUTH。
CAMUNDA_PROXY_TARGET=http://192.168.124.202:8085
# 可选，格式为 username:password；这是 Vite 服务端变量，不要加 VITE_ 前缀。
CAMUNDA_PROXY_AUTH=
# 以下仅用于界面显示和入口控制，不包含任何密钥。
VITE_CAMUNDA_ACCESS_MODE=direct
VITE_CAMUNDA_TENANT=tenant-a
VITE_BUSINESS_WORKFLOW_ENABLED=true
VITE_WORKFLOW_DEVTOOLS=true

{
  "name": "bpmn-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.9.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @workflow/designer build && vite",
    "build": "pnpm --filter @workflow/designer build && vue-tsc --noEmit && vite build",
    "typecheck": "pnpm --filter @workflow/designer typecheck && vue-tsc --noEmit",
    "test": "pnpm --filter @workflow/designer test && node --test tests/*.test.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@workflow/designer": "workspace:*",
    "@vue-flow/core": "^1.48.2",
    "@bpmn-io/element-template-chooser": "3.0.0",
    "@bpmn-io/properties-panel": "3.57.1",
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.12.2",
    "bpmn-js": "^18.6.1",
    "bpmn-js-element-templates": "2.38.0",
    "bpmn-js-properties-panel": "5.65.2",
    "camunda-bpmn-js-behaviors": "1.18.0",
    "camunda-bpmn-moddle": "8.0.1",
    "diagram-js": "15.26.0",
    "element-plus": "^2.11.3",
    "elkjs": "0.12.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^27.0.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.0"
  }
}

{
  "processId": "timeout_actions",
  "processName": "审批超时策略",
  "nodes": [
    {
      "id": "start",
      "type": "start",
      "name": "开始"
    },
    {
      "id": "apply",
      "type": "approval",
      "reminder": {
        "duration": "PT1H",
        "action": "notify"
      },
      "name": "申请审批"
    },
    {
      "id": "review",
      "type": "approval",
      "reminder": {
        "action": "return",
        "target": "apply"
      },
      "name": "复核审批"
    },
    {
      "id": "final",
      "type": "approval",
      "reminder": {
        "action": "end"
      },
      "name": "最终审批"
    },
    {
      "id": "end",
      "type": "end",
      "name": "结束"
    }
  ],
  "flows": [
    {
      "source": "start",
      "target": "apply"
    },
    {
      "source": "apply",
      "target": "review"
    },
    {
      "source": "review",
      "target": "final"
    },
    {
      "source": "final",
      "target": "end"
    }
  ]
}

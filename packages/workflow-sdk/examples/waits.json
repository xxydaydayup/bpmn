{
  "processId": "message_and_timer",
  "processName": "消息与定时等待",
  "nodes": [
    {
      "id": "start",
      "type": "start",
      "name": "开始"
    },
    {
      "id": "ack",
      "type": "receive",
      "messageName": "request.acknowledged",

      "timerValue": "PT30M",
      "name": "等待三十分钟"
    },
    {
      "id": "runtime",
      "type": "timer",
      "name": "等待指定时长"
    },
    {
      "id": "end",
      "type": "end",
      "name": "结束"
    }
  ],
  "flows": [
    {
      "source": "start",
      "target": "ack"
    },
    {
      "source": "ack",
      "target": "delay"
    },
    {
      "source": "delay",
      "target": "runtime"
    },
    {
      "source": "runtime",
      "target": "end"
    }
  ]

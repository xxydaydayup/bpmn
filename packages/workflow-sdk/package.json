{
  "name": "@workflow/sdk",
  "version": "0.2.0",
  "type": "module",
  "description": "Framework independent workflow model, functional definitions and explicit business gateway client",
  "sideEffects": false,
  "engines": { "node": "^20.19.0 || >=22.12.0" },
  "files": ["dist", "schema", "contract", "examples", "docs", "README.md"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./definition": { "types": "./dist/definition.d.ts", "import": "./dist/definition.js" },
    "./client": { "types": "./dist/client.d.ts", "import": "./dist/client.js" },
    "./schema/workflow-model-v1.schema.json": "./schema/workflow-model-v1.schema.json",
    "./contract/*": "./contract/*",
    "./examples/*": "./examples/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/write-schema.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "prepack": "pnpm build",
    "verify:package": "node scripts/verify-package.mjs",
    "test:backend": "pnpm build && node scripts/check-backend.mjs",
    "test:runtime": "pnpm build && node scripts/check-runtime.mjs"
  },
  "devDependencies": { "ajv": "^8.17.1", "typescript": "~5.9.2" }
}

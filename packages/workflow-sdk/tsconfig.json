{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022"], "types": [],
    "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "verbatimModuleSyntax": true,
    "noUnusedLocals": true, "noUnusedParameters": true,
    "declaration": true, "outDir": "dist", "rootDir": "src",
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}

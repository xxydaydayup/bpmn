<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:wf="https://bpmn-workspace.local/schema/workflow"
  id="Definitions_Process_AmountApproval" targetNamespace="https://bpmn-workspace.local/processes">
  <bpmn:process id="Process_AmountApproval" name="金额分支审批" isExecutable="true">
    <bpmn:startEvent id="Start_Amount" name="开始">
      <bpmn:outgoing>Flow_Amount_Start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Expense" name="提交报销" wf:assignee="requester" wf:formKey="expense">
      <bpmn:incoming>Flow_Amount_Start</bpmn:incoming>
      <bpmn:outgoing>Flow_Amount_Check</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Amount" name="报销金额" default="Flow_Standard">
      <bpmn:incoming>Flow_Amount_Check</bpmn:incoming>
      <bpmn:outgoing>Flow_High</bpmn:outgoing>
      <bpmn:outgoing>Flow_Standard</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_High" name="高额审批" wf:assignee="director">
      <bpmn:incoming>Flow_High</bpmn:incoming>
      <bpmn:outgoing>Flow_High_Merge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Standard" name="普通审批" wf:assignee="manager">
      <bpmn:incoming>Flow_Standard</bpmn:incoming>
      <bpmn:outgoing>Flow_Standard_Merge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Merge" name="汇合">
      <bpmn:incoming>Flow_High_Merge</bpmn:incoming>
      <bpmn:incoming>Flow_Standard_Merge</bpmn:incoming>
      <bpmn:outgoing>Flow_Amount_End</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Amount" name="结束">
      <bpmn:incoming>Flow_Amount_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Amount_Start" sourceRef="Start_Amount" targetRef="Task_Expense">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Amount_Check" sourceRef="Task_Expense" targetRef="Gateway_Amount">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_High" sourceRef="Gateway_Amount" targetRef="Task_High" name="金额 &gt; 5000">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">amount &gt; 5000</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Standard" sourceRef="Gateway_Amount" targetRef="Task_Standard" name="其他金额">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_High_Merge" sourceRef="Task_High" targetRef="Gateway_Merge">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Standard_Merge" sourceRef="Task_Standard" targetRef="Gateway_Merge">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Amount_End" sourceRef="Gateway_Merge" targetRef="End_Amount">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Process_AmountApproval">
    <bpmndi:BPMNPlane id="Plane_Process_AmountApproval" bpmnElement="Process_AmountApproval">
      <bpmndi:BPMNShape id="Start_Amount_di" bpmnElement="Start_Amount">
        <dc:Bounds x="50" y="222" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="30" y="266" width="90" height="20" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Expense_di" bpmnElement="Task_Expense">
        <dc:Bounds x="145" y="200" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Amount_di" bpmnElement="Gateway_Amount" isMarkerVisible="true">
        <dc:Bounds x="330" y="215" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="310" y="273" width="90" height="20" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_High_di" bpmnElement="Task_High">
        <dc:Bounds x="470" y="100" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Standard_di" bpmnElement="Task_Standard">
        <dc:Bounds x="470" y="300" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Merge_di" bpmnElement="Gateway_Merge" isMarkerVisible="true">
        <dc:Bounds x="680" y="215" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="660" y="273" width="90" height="20" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Amount_di" bpmnElement="End_Amount">
        <dc:Bounds x="830" y="222" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="810" y="266" width="90" height="20" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Amount_Start_di" bpmnElement="Flow_Amount_Start">
        <di:waypoint x="86" y="240" />
        <di:waypoint x="145" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Amount_Check_di" bpmnElement="Flow_Amount_Check">
        <di:waypoint x="265" y="240" />
        <di:waypoint x="330" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_High_di" bpmnElement="Flow_High">
        <di:waypoint x="355" y="215" />
        <di:waypoint x="355" y="140" />
        <di:waypoint x="470" y="140" />
        <bpmndi:BPMNLabel><dc:Bounds x="366" y="108" width="90" height="20" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Standard_di" bpmnElement="Flow_Standard">
        <di:waypoint x="355" y="265" />
        <di:waypoint x="355" y="340" />
        <di:waypoint x="470" y="340" />
        <bpmndi:BPMNLabel><dc:Bounds x="373" y="350" width="80" height="20" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_High_Merge_di" bpmnElement="Flow_High_Merge">
        <di:waypoint x="590" y="140" />
        <di:waypoint x="705" y="140" />
        <di:waypoint x="705" y="215" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Standard_Merge_di" bpmnElement="Flow_Standard_Merge">
        <di:waypoint x="590" y="340" />
        <di:waypoint x="705" y="340" />
        <di:waypoint x="705" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Amount_End_di" bpmnElement="Flow_Amount_End">
        <di:waypoint x="730" y="240" />
        <di:waypoint x="830" y="240" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  id="Definitions_Process_Countersign" targetNamespace="https://bpmn-workspace.local/processes">
  <bpmn:process id="Process_Countersign" name="会签审批" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:documentation>启动提供 assigneeStart 和非空 approverList。提交评审完成时自动清零 agreeCount；每位评审人完成任务时提供 vote=agree 或 reject。等待全员完成，全员同意则通过，否则退回重提。使用 Camunda EL 表达式监听器。</bpmn:documentation>
    <bpmn:startEvent id="Start_Review" name="开始">
      <bpmn:outgoing>Flow_ReviewStart</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_ReviewApply" name="提交评审" camunda:assignee="${assigneeStart}">
      <bpmn:extensionElements>
        <camunda:executionListener event="end" expression="${execution.setVariable('agreeCount', 0)}" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ReviewStart</bpmn:incoming>
      <bpmn:incoming>Flow_ReviewReturn</bpmn:incoming>
      <bpmn:outgoing>Flow_ReviewSubmit</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_MultiReview" name="多人会签" camunda:assignee="${assignee}">
      <bpmn:extensionElements>
        <camunda:executionListener event="end" expression="${execution.setVariable('agreeCount', vote == 'agree' ? agreeCount + 1 : agreeCount)}" />
        <camunda:executionListener event="end" expression="${execution.setVariable('totalApproverCount', nrOfInstances)}" />
        <camunda:formData>
          <camunda:formField id="vote" label="审批意见" type="enum">
            <camunda:value id="agree" name="同意" />
            <camunda:value id="reject" name="拒绝" />
          </camunda:formField>
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ReviewSubmit</bpmn:incoming>
      <bpmn:outgoing>Flow_ReviewResult</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="false" camunda:collection="${approverList}" camunda:elementVariable="assignee">
        <bpmn:completionCondition xsi:type="bpmn:tFormalExpression">${nrOfCompletedInstances == nrOfInstances}</bpmn:completionCondition>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ReviewResult" name="结果" default="Flow_ReviewReturn">
      <bpmn:incoming>Flow_ReviewResult</bpmn:incoming>
      <bpmn:outgoing>Flow_ReviewApproved</bpmn:outgoing>
      <bpmn:outgoing>Flow_ReviewReturn</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_ReviewApproved" name="结束">
      <bpmn:incoming>Flow_ReviewApproved</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ReviewStart" sourceRef="Start_Review" targetRef="Task_ReviewApply">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ReviewSubmit" sourceRef="Task_ReviewApply" targetRef="Task_MultiReview">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ReviewResult" sourceRef="Task_MultiReview" targetRef="Gateway_ReviewResult">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ReviewApproved" sourceRef="Gateway_ReviewResult" targetRef="End_ReviewApproved" name="通过">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${agreeCount == totalApproverCount}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ReviewReturn" sourceRef="Gateway_ReviewResult" targetRef="Task_ReviewApply" name="不通过，退回重提">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Process_Countersign"><bpmndi:BPMNPlane id="Plane_Process_Countersign" bpmnElement="Process_Countersign">
    <bpmndi:BPMNShape id="Start_Review_di" bpmnElement="Start_Review"><dc:Bounds x="50" y="182" width="36" height="36" />
      <bpmndi:BPMNLabel><dc:Bounds x="23" y="226" width="90" height="40" /></bpmndi:BPMNLabel>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Task_ReviewApply_di" bpmnElement="Task_ReviewApply"><dc:Bounds x="150" y="160" width="110" height="80" />
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Task_MultiReview_di" bpmnElement="Task_MultiReview"><dc:Bounds x="360" y="160" width="110" height="80" />
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Gateway_ReviewResult_di" bpmnElement="Gateway_ReviewResult" isMarkerVisible="true"><dc:Bounds x="580" y="175" width="50" height="50" />
      <bpmndi:BPMNLabel><dc:Bounds x="560" y="233" width="90" height="40" /></bpmndi:BPMNLabel>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="End_ReviewApproved_di" bpmnElement="End_ReviewApproved"><dc:Bounds x="790" y="102" width="36" height="36" />
      <bpmndi:BPMNLabel><dc:Bounds x="763" y="146" width="90" height="40" /></bpmndi:BPMNLabel>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="Flow_ReviewStart_di" bpmnElement="Flow_ReviewStart">
      <di:waypoint x="86" y="200" />
      <di:waypoint x="150" y="200" />
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_ReviewSubmit_di" bpmnElement="Flow_ReviewSubmit">
      <di:waypoint x="260" y="200" />
      <di:waypoint x="360" y="200" />
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_ReviewResult_di" bpmnElement="Flow_ReviewResult">
      <di:waypoint x="470" y="200" />
      <di:waypoint x="580" y="200" />
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_ReviewApproved_di" bpmnElement="Flow_ReviewApproved">
      <di:waypoint x="605" y="175" />
      <di:waypoint x="605" y="120" />
      <di:waypoint x="790" y="120" />
      <bpmndi:BPMNLabel><dc:Bounds x="650" y="90" width="110" height="40" /></bpmndi:BPMNLabel>
    </bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_ReviewReturn_di" bpmnElement="Flow_ReviewReturn">
      <di:waypoint x="605" y="225" />
      <di:waypoint x="605" y="400" />
      <di:waypoint x="205" y="400" />
      <di:waypoint x="205" y="240" />
      <bpmndi:BPMNLabel><dc:Bounds x="336" y="415" width="148" height="40" /></bpmndi:BPMNLabel>
    </bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>

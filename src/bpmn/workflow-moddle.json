{
  "name": "Workflow",
  "uri": "https://bpmn-workspace.local/schema/workflow",
  "prefix": "wf",
  "xml": {
    "tagAlias": "lowerCase"
  },
  "types": [
    {
      "name": "UserTaskProperties",
      "extends": ["bpmn:UserTask"],
      "properties": [
        {
          "name": "assignee",
          "type": "String",
          "isAttr": true
        },
        {
          "name": "formKey",
          "type": "String",
          "isAttr": true
        }
      ]
    },
    {
      "name": "Approval",
      "superClass": ["Element"],
      "properties": [
        { "name": "version", "type": "String", "isAttr": true },
        { "name": "policy", "type": "String", "isAttr": true },
        { "name": "participants", "type": "Participant", "isMany": true }
      ]
    },
    {
      "name": "Participant",
      "superClass": ["Element"],
      "properties": [
        { "name": "userId", "type": "String", "isAttr": true }
      ]
    }
  ]
}
